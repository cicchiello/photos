#!/bin/bash

if [ $# -lt 2 ]; then
    echo "Usage: $0 <base-path> <backup-root>"
    exit 1
fi
base=$1
root=$2
rmtroot=$3
server=http://mediaserver:5984
db=photos
log=${base}/logs/photos-backup.log
prog=${base}/photos/py/backup.py

filedate=$(date +%Y%m%d)
dirname="${filedate}_backup"
dirpath="${root}/${dirname}"
mkdir -p ${dirpath}

# force python to treat stdout/stderr as line-buffered outputs
export PYTHONUNBUFFERED=1

timestamp=$(date)
echo "INFO:(${timestamp}): invoking ${prog}" >> ${log}
echo "INFO:(${timestamp}): to backup: ${server}/${db}" >> ${log}
echo "INFO:(${timestamp}): to dir: ${dirpath}" >> ${log}
nice ${prog} -db ${server}/${db} -dir ${dirpath} 2>&1 >> ${log}
stat=$?
timestamp=$(date)
echo "INFO:(${timestamp}): Done ${prog} extraction" >> ${log}
if [ ${stat} -eq 0 ]; then
    echo "INFO:(${timestamp}): Command succeeded; zipping it up" >> ${log}
    cd "${root}"

    # Here's the effective command to issue to create tarball and cleanup:
    #   > tar cfz "${dirname}.tar.gz" ${dirname} && rm -rf ${dirname}
    # But, that's surprisingly slow and there's a **way** faster way (by hours!)
    # ... doing both operations natively/locally on the NAS server
    cdcmd="cd ${rmtroot}"
    tarcmd="tar cfz ${dirname}.tar.gz ${dirname}"
    cleancmd="find ${dirname} -type f -delete && rm -rf ${dirname}"
    rcmd="${cdcmd} && ${tarcmd} && ${cleancmd}"
    echo "INFO:(${timestamp}): issuing remote pi-nas cmd: ${rcmd}" >> ${log}
    ssh joe@pi-nas "${rcmd}"
    stat=$?
    
    timestamp=$(date)

    if [ ${stat} -eq 0 ]; then
	timestamp=$(date)
        echo "INFO:(${timestamp}): Done zipping" >> ${log}

	cutoff=$(date -d "$(date +%Y-%m-01) -1 month" +%Y%m%d)
	timestamp=$(date)
	echo "INFO:(${timestamp}): Removing backups older than ${cutoff}" >> ${log}
	for f in *.tar.gz; do
	    [ -f "$f" ] || continue
	    filedate=${f:0:8}
	    if [[ "$filedate" < "$cutoff" ]]; then
		timestamp=$(date)
		echo "INFO:(${timestamp}): Deleting old backup: ${f}" >> ${log}
		rm -f "${f}"
	    fi
	done
    else
	timestamp=$(date)
        echo "INFO:(${timestamp}): Zipping failed" >> ${log}
    fi
else
    timestamp=$(date)
    echo "INFO:(${timestamp}): Command failed" >> ${log}
fi
